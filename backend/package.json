{
  "name": "backend",
  "version": "1.0.0",
  "description": "Server for Food Delivery App",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --testPathIgnorePatterns=integration --runInBand",
    "test:unit": "jest --testPathIgnorePatterns=integration --runInBand",
    "test:integration": "jest tests/prisma.integration.test.js --runInBand",
    "test:all": "jest --runInBand",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "socket.io": "^4.8.4",
    "stripe": "^20.3.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "prisma": "^6.4.0",
    "supertest": "^7.2.2"
  }
}
