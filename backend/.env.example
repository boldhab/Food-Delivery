# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_delivery?schema=public
# Legacy MongoDB (Optional during migration)
MONGODB_URI=mongodb://localhost:27017/food-delivery

# Authentication
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated for client, admin, driver frontends)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
